<!DOCTYPE html>
<html>
<head>
  <title>Invoice List - VendorPay</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="auth-container" style="max-width: 1100px;">
    <div class="auth-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h1>🧾 Invoices</h1>
        <a href="/invoice/create" style="background:#4f46e5; color:white; padding:10px 20px; border-radius:8px; text-decoration:none;">+ Create New Invoice</a>
      </div>

      <hr>

      <% if (invoices && invoices.length > 0) { %>
        <table style="width:100%; margin-top:20px; border-collapse:collapse; font-size:14px;">
          <tr style="background:#f3f4f6;">
            <th style="padding:12px; text-align:left;">Invoice #</th>
            <th style="padding:12px; text-align:left;">PO #</th>
            <th style="padding:12px; text-align:left;">Vendor</th>
            <th style="padding:12px; text-align:left;">Date</th>
            <th style="padding:12px; text-align:left;">Amount</th>
            <th style="padding:12px; text-align:left;">Status</th>
            <th style="padding:12px; text-align:left;">Action</th>
          </tr>
          <% invoices.forEach(inv => { %>
            <tr style="border-bottom:1px solid #e5e7eb;">
              <td style="padding:12px;"><strong><%= inv.invoice_number %></strong></td>
              <td style="padding:12px;"><%= inv.purchase_orders ? inv.purchase_orders.po_number : 'N/A' %></td>
              <td style="padding:12px;"><%= inv.vendor %></td>
              <td style="padding:12px;"><%= inv.invoice_date %></td>
              <td style="padding:12px;">R <%= parseFloat(inv.total_amount).toFixed(2) %></td>
              <td style="padding:12px;">
                <span style="background:<%= inv.approval_status === 'approved' ? '#d1fae5' : inv.approval_status === 'rejected' ? '#fee2e2' : '#fef3c7' %>; padding:4px 12px; border-radius:12px; font-size:0.8rem;">
                  <%= inv.approval_status || 'pending' %>
                </span>
              </td>
              <td style="padding:12px;">
                <% if (inv.approval_status === 'pending' || !inv.approval_status) { %>
                  <form action="/invoice/<%= inv.id %>/approve" method="POST" style="display:inline;">
                    <button type="submit" style="background:#059669; color:white; border:none; padding:5px 12px; border-radius:5px; cursor:pointer;">Approve</button>
                  </form>
                  <form action="/invoice/<%= inv.id %>/reject" method="POST" style="display:inline;">
                    <button type="submit" style="background:#dc2626; color:white; border:none; padding:5px 12px; border-radius:5px; cursor:pointer;">Reject</button>
                  </form>
                <% } else { %>
                  <span style="color:#6b7280; font-size:0.8rem;">Done</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </table>
      <% } else { %>
        <p style="text-align:center; color:#6b7280; padding:40px 0;">
          No Invoices created yet.
          <br><br>
          <a href="/invoice/create" style="color:#4f46e5; font-weight:600;">Create your first Invoice →</a>
        </p>
      <% } %>
    </div>
  </div>
</body>
</html>