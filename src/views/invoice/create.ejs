<!DOCTYPE html>
<html>
<head>
  <title>Create Invoice - VendorPay</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="auth-container" style="max-width: 600px;">
    <div class="auth-card">
      <h1>🧾 Create Invoice</h1>
      <a href="/invoice/list" style="color:#4f46e5;">← Back</a>
      <hr>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/invoice/create" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>Upload Invoice (JPG/PNG/PDF)</label>
          <input type="file" name="invoice_file" accept=".jpg,.jpeg,.png,.pdf">
          <small style="color:#6b7280;">Upload to auto-fill. Or type manually.</small>
        </div>
        <hr>

        <div class="form-group">
          <label>Invoice Number</label>
          <input type="text" name="invoice_number" placeholder="INV-001"
                 value="<%= extractedData ? extractedData.invoiceNumber : '' %>">
        </div>

        <div class="form-group">
          <label>Purchase Order</label>
          <select name="po_id" required>
            <option value="">Select a PO</option>
            <% pos.forEach(po => { %>
              <option value="<%= po.id %>"><%= po.po_number %> - <%= po.vendor %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Vendor</label>
          <input type="text" name="vendor" placeholder="ABC Supplies"
                 value="<%= extractedData ? extractedData.vendor : '' %>">
        </div>

        <div class="form-group">
          <label>Invoice Date</label>
          <input type="date" name="invoice_date"
                 value="<%= extractedData ? extractedData.date : '' %>">
        </div>

        <div class="form-group">
          <label>Total Amount</label>
          <input type="number" step="0.01" name="total_amount" placeholder="1500.00"
                 value="<%= extractedData ? extractedData.totalAmount : '' %>">
        </div>

        <div class="form-group">
          <label>VAT</label>
          <input type="number" step="0.01" name="vat" placeholder="150.00"
                 value="<%= extractedData ? extractedData.vat : '' %>">
        </div>

        <button type="submit" class="btn-primary">Create Invoice</button>
      </form>

      <% if (extractedData && extractedData.invoiceNumber) { %>
        <div style="background:#ecfdf5; padding:15px; border-radius:8px; margin-top:20px;">
          <p style="margin:0; color:#059669;">✅ AI Extracted:
            <strong>#<%= extractedData.invoiceNumber %></strong> |
            R<%= extractedData.totalAmount || '0' %>
          </p>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>